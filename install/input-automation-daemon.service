[Unit]
Description=input-automation macro daemon (fires macros from device triggers)
# Tie the daemon to the graphical session: it injects input into it.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/input-automation daemon
Restart=on-failure
RestartSec=2
# The daemon needs the session D-Bus only for screen capture backends,
# not for trigger firing — but exporting it is harmless and future-proof.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

[Install]
WantedBy=graphical-session.target
